{
  "name": "quantum-language",
  "displayName": "Quantum Language",
  "description": "Syntax highlighting, multi-syntax coloring, auto-completion, and snippets for Quantum Language (.sa files)",
  "version": "1.1.1",
  "publisher": "MuhammadSaadAmin",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": ["Programming Languages", "Snippets"],
  "icon": "quantum-icon.png",
  "contributes": {
    "languages": [
      {
        "id": "quantum",
        "aliases": ["Quantum", "quantum", "sa"],
        "extensions": [".sa"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "quantum",
        "scopeName": "source.quantum",
        "path": "./syntaxes/quantum.tmlanguage.json"
      }
    ],
    "configurationDefaults": {
      "[quantum]": {
        "editor.tokenColorCustomizations": {
          "textMateRules": [
            { "scope": ["comment", "comment.line", "comment.block", "punctuation.definition.comment"], "settings": { "foreground": "#3FA34D", "fontStyle": "italic" } },
            { "scope": ["meta.preprocessor.quantum", "keyword.control.directive.quantum"], "settings": { "foreground": "#2F80ED", "fontStyle": "" } },
            { "scope": ["string.quoted.other.lt-gt.include.quantum", "entity.name.function.preprocessor.quantum"], "settings": { "foreground": "#56B6C2" } }
          ]
        }
      }
    },
    "snippets": [
      {
        "language": "quantum",
        "path": "./snippets/quantum.json"
      }
    ],
    "configuration": [
      {
        "title": "Quantum Language",
        "properties": {
          "quantum.languageServer.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable Quantum Language Server"
          },
          "quantum.format.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable Quantum code formatting"
          },
          "quantum.linting.excludeGlobs": {
            "type": "array",
            "items": { "type": "string" },
            "default": ["**/compiler/src/**", "**/src/generated/**", "**/src/java/**"],
            "description": "Files matching these globs are not checked on their own: they are fragments that only compile together with other files (the compiler's own sources, the Java library classes)."
          },
          "quantum.linting.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable Quantum linting"
          },
          "quantum.autocomplete.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Enable Quantum auto-completion"
          }
        }
      }
    ]
  },
  "activationEvents": ["onLanguage:quantum"],
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^7.0.0",
    "vscode-languageserver": "^7.0.0",
    "vscode-languageserver-textdocument": "^1.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.60.0",
    "@types/node": "^16.x",
    "typescript": "^4.4.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SENODROOM/Quantum-Language.git"
  },
  "keywords": ["quantum", "programming language", "cybersecurity", "scripting", "autocomplete", "syntax highlighting", "multi-syntax"],
  "author": "Muhammad Saad Amin",
  "license": "MIT"
}
